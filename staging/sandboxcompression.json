{"version":3,"kind":"Article","sha256":"b57d78e5713d340328df73c01a8b9b640e28201472121454c606360201392ed5","slug":"sandboxcompression","location":"/Jupyterbook/Exercises/SandboxCompression.md","dependencies":[],"frontmatter":{"title":"Exercises: Build your own Mountain belt","content_includes_title":false,"github":"https://github.com/ANU-RSES-Education/EMSC-3002","numbering":{"title":{"offset":2}},"source_url":"https://github.com/ANU-RSES-Education/EMSC-3002/blob/main/Jupyterbook/Exercises/SandboxCompression.md","edit_url":"https://github.com/ANU-RSES-Education/EMSC-3002/edit/main/Jupyterbook/Exercises/SandboxCompression.md","thumbnail":"/EMSC-3002/staging/build/Sandbox1-bda5f0cb47f248864ae3772d67f67662.jpg","exports":[{"format":"md","filename":"SandboxCompression.md","url":"/EMSC-3002/staging/build/SandboxCompression-ed00c7c6fa5fd9def71771f965068517.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Analogue Sandbox in Compression.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"C1GzkP2mno"}],"identifier":"analogue-sandbox-in-compression","label":"Analogue Sandbox in Compression.","html_id":"analogue-sandbox-in-compression","implicit":true,"key":"BdtSJZ0dtg"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The following exercise is based on Sandra McLaren’s teaching at The University of Melbourne.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"mqQynVlVvl"}],"key":"EHS8eXK8kX"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"wYQj8c7OX4"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"bXNyCBsjcG"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Physical modeling of folding and faulting has been performed since the early days of Structural Geology.\nThe traditional way of performing analogue experiments is by filling a box with materials such as clay, sand, plaster, silicone putty, honey etc. and\nto apply extension or contraction at the boundaries. Ideally the model geometry and physical properties of the material should be scaled proportionally.\nThe kinematics of the model should also be similar to the natural example, with comparable rates of deformation and mechanical properties.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"KiPHOW0ZX7"}],"key":"ri4lWTqzb2"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"In practice, it is impossible to scale all the parameters appropriately and some sort of compromises must be found.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"R0fJITYfut"}],"key":"pQFaMg0Bal"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"For a small physical model to realistically reproduce a natural example, we need to scale down the geometries and properties of the materials as best as we can.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"fsNVPUY2KY"}],"key":"TKkEBg2E0J"}],"key":"UXUaslX1Qm"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Analogue experiments remain extremely useful to understand the processes and their interaction. They allow us to develop our understanding of tectonic deformation mechanism and style observed in\nnatural systems.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"GM6G5ruZif"}],"key":"uevwRhc7qp"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"In this practical we will run our own analogue modelling experiment to explore the controls on the structure and development of fold and thrust belts (the foreland of orogenic systems)","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"AnXU4Ztiov"}],"key":"XQHtYcn7OK"},{"type":"div","children":[{"type":"div","style":{"width":"45%","float":"left"},"children":[{"type":"image","url":"/EMSC-3002/staging/build/Sandbox1-bda5f0cb47f248864ae3772d67f67662.jpg","key":"oYfjkiIax6","urlSource":"Figures/SandboxCompression/Sandbox1.jpg"}],"key":"rcBDtwEGK3"},{"type":"div","style":{"width":"45%","float":"right"},"children":[],"key":"F2DfP0cZtJ"}],"key":"s0APt3PbU3"},{"type":"image","url":"/EMSC-3002/staging/build/Sandbox2-cd02e72797f386ff68a35577a6169e12.jpg","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"xGtWPkZmLx","urlSource":"Figures/SandboxCompression/Sandbox2.jpg"},{"type":"heading","depth":2,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Learning outcomes","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"zFxpT2lVUv"}],"identifier":"learning-outcomes","label":"Learning outcomes","html_id":"learning-outcomes","implicit":true,"key":"VNJZZAOiUS"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"At the completion of this practical you should:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"iMXqVEera8"}],"key":"ujUriVkryw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":39,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Have developed skills in the design and management of experiments, including formulating hypotheses","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"KUbMxBEu5g"}],"key":"xQAu6z8RpZ"}],"key":"AzWdf6Qfti"},{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Be able to document experimental methods and results in a laboratory report","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Yii7Re8own"}],"key":"y9FifmbA2a"}],"key":"uknmliXwBc"},{"type":"listItem","spread":true,"position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Understand the major controls on fold and thrust belt evolution","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"c6KNmJ6zdQ"}],"key":"oXHKGEtAMy"}],"key":"HO2MpoMP2p"},{"type":"listItem","spread":true,"position":{"start":{"line":42,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Understand the geometry of structures formed in fold and thrust belts","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"Rumj5z0ErO"}],"key":"kvo6jzoKA5"}],"key":"O4kTIhCDk1"}],"key":"KYySVHD0mg"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Generic Skills","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"zQdr5Li5kP"}],"identifier":"generic-skills","label":"Generic Skills","html_id":"generic-skills","implicit":true,"key":"AV4OQuoGO8"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"This practical exercise will help you develop skills in:","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"yKPg6uZXBk"}],"key":"Q4f2G0CS9j"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":48,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Effective communication including written report writing","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"pd2T2HfPfQ"}],"key":"A5FzZtACGf"}],"key":"pVTCYUu6Y5"},{"type":"listItem","spread":true,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Critical thinking and the conceptualization of complex and abstract ideas","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"EZOUWqmZVf"}],"key":"kyu5qVMAVY"}],"key":"uLdzfJH7Hl"},{"type":"listItem","spread":true,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Problem-solving in new and unfamiliar tasks","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"svzxBx9baU"}],"key":"QtuKfdJTQn"}],"key":"fEnMfbWm5w"},{"type":"listItem","spread":true,"position":{"start":{"line":51,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Effective collaboration team-work","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"kl8lw7j3LE"}],"key":"tzocPoSn9K"}],"key":"TmTnag2TOx"}],"key":"BOD3NojeHU"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Only one sandbox is available so you will have to work as a team and make sure that everyone has an understanding of the different steps involved.\nThe sandbox is a plexiglass-sided box with a motor-driven indenter at one end. Our experiment involves driving the indenter into the premade layers and observing and\ndocumenting how the layers of sand deform. As noted above, the experiment simulates the style of tectonic deformation we might observe in orogenic systems.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"ca4zrxIydC"}],"key":"NHqsEsw9MF"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"You will need:","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"KXDAQdE3Mm"}],"key":"nYRhs9fnvx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":59,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Rulers: metre rules provided and smaller rulers also required","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"AMqiqtEzIx"}],"key":"iJmJ6Z7ID3"}],"key":"NS9T0aVGFU"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Protractor","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"QxSjxluZXe"}],"key":"JBxbyzskyx"}],"key":"X5IH5WSqlp"},{"type":"listItem","spread":true,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plain paper for sketching","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"dKUPRPTtCL"}],"key":"TcwwvkIOaS"}],"key":"DAkLRY2DDu"},{"type":"listItem","spread":true,"position":{"start":{"line":62,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Your phone for taking photos or recording video: A webcam on a tripod will be provided.","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"vCgwGYamUi"}],"key":"UaDKWu7hSn"}],"key":"Elk6uKldZ3"}],"key":"xmBwC3ZqSG"},{"type":"heading","depth":2,"position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Points to consider","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"l39Mej47AY"}],"identifier":"points-to-consider","label":"Points to consider","html_id":"points-to-consider","implicit":true,"key":"WHkcdyrFDC"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":67,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":67,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As you advance the indenter, does the sand shorten and thicken uniformly or is the\ndeformation localised (partitioned) along discrete planes?","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"z58HdJx7jE"}],"key":"wep9u52wWf"}],"key":"IoyyiZo6gr"},{"type":"listItem","spread":true,"position":{"start":{"line":69,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How much deformation is required before the first fault forms? What is the dip of\nthat fault?","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"bQ5EAjbhOa"}],"key":"bziWJJiPz8"}],"key":"A5vjjhW0m8"},{"type":"listItem","spread":true,"position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Where do the new faults develop?","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"TGqpHpeDOI"}],"key":"nNZZqrbYvW"}],"key":"mdViZsNy1Z"},{"type":"listItem","spread":true,"position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do the fault angles change during the experiment? If so, do they get steeper or\nshallower?","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"sd5vONi77j"}],"key":"ARpRMpFD8f"}],"key":"f0EbllZhPQ"},{"type":"listItem","spread":true,"position":{"start":{"line":74,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Observe and describe the surface of the model as the deformation proceeds. Is it\nsmooth or lumpy? If there are surface features, can you explain them in terms of the\ndeformation observed in cross-section? What else happens to modify the surface?","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"EN5FiJdvD8"}],"key":"ukMZawSW8h"}],"key":"uUbsmGsZcm"},{"type":"listItem","spread":true,"position":{"start":{"line":77,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How does the width of the deformed zone change with time? How is the deformation\npartitioned at any particular time?","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"bqJ4BbXfl3"}],"key":"zYEinzn3J6"}],"key":"hyIANxi7Dg"},{"type":"listItem","spread":true,"position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Calculate the overall shortening for the experiment","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"F6M0kJke3K"}],"key":"LCR08PfJ32"}],"key":"Qdh8GFfKA5"},{"type":"listItem","spread":true,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plot the number of faults vs the indenter displacement","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"fdjueSeMMD"}],"key":"TolKu3LfzI"}],"key":"mZnHTEoWVo"},{"type":"listItem","spread":true,"position":{"start":{"line":81,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What areas of the model are likely to be affected by ongoing deformation? Consider\nthis for a land-use scenario, mitigating natural hazards from earthquakes in active\nfold and thrust belts","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"Sd5IKfK4LF"}],"key":"AJBYmbYD38"}],"key":"H6ZZpcjj4G"},{"type":"listItem","spread":true,"position":{"start":{"line":84,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How do you think the ongoing deformation might change the geomorphology of the\nregion?","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"CshIebWgfl"}],"key":"DrAswhlyqN"}],"key":"lZMaSncGAa"},{"type":"listItem","spread":true,"position":{"start":{"line":86,"column":1},"end":{"line":88,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How well did the results match up with your predictions about (1) the factors that\ncontrol the deformation and (2) the geometry of the structures that developed.","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"DbOJoWmk6A"}],"key":"nLoNmsUTmJ"}],"key":"ObwSRzIwo7"}],"key":"disSpKaDC3"},{"type":"heading","depth":2,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Exercise","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"EscngqCUoE"}],"identifier":"exercise","label":"Exercise","html_id":"exercise","implicit":true,"key":"pUMhFeuP8N"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":91,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":91,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Formulate hypotheses about the factors that may control deformation within your\nsandbox. Use your theoretical knowledge of crustal deformation to inform your\nanswers.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"AHIqG7tUuf"}],"key":"c7jTTApFrr"}],"key":"FL5z9JpJId"},{"type":"listItem","spread":true,"position":{"start":{"line":95,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Note the composition of the layers in your sandbox","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"FWcG9gdXB5"}],"key":"tBIERtqkrk"}],"key":"LcMCIwVlAu"},{"type":"listItem","spread":true,"position":{"start":{"line":97,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Make predictions about the geometry of the structures you might expect to observe.\nYou might want to provide sketches and also consider how the geometry might\nchange with time. Remember to indicate the position of the indenter and its sense of\nmovement.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"oZQMYDtcv7"}],"key":"XtWaLnumS0"}],"key":"iM18hLB2J2"},{"type":"listItem","spread":true,"position":{"start":{"line":102,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Measure and record the pre-deformational dimensions of the material within the\nsandbox. Use the ruler provided on the base of the box to provide a reference\nthroughout your experiment.","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"uVrNLSKkjB"}],"key":"BxRQPoMYBp"}],"key":"medUqRydrD"},{"type":"listItem","spread":true,"position":{"start":{"line":106,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":109,"column":1}},"children":[{"type":"text","value":"Begin the deformation experiment! Note that you will need to carefully control the\nspeed of the indenter. Work slowly to begin with to see how the motor responds, it\ncan be a bit touchy, it might seem to be going really slow, but then a small change\nmakes it go really quite fast!","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"KUtby4tP35"}],"key":"snk0lmMQf4"}],"key":"BHcg8FeEeI"},{"type":"listItem","spread":true,"position":{"start":{"line":111,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":111,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"Observe carefully the changes in the model as your experiment proceeds. You might\nwant to time the experiment. You can stop and start the indenter at any time. This is\nuseful for pausing the experiment to make measurements or sketches at key stages.","position":{"start":{"line":111,"column":1},"end":{"line":111,"column":1}},"key":"AmIbEZAZMK"}],"key":"wZ7Z9YE1y7"}],"key":"ZONCHw2YOL"},{"type":"listItem","spread":true,"position":{"start":{"line":115,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":115,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"text","value":"At key intervals sketch the geometry of the model and make observations, such as\nthose listed in the table below. You may also want to record other details, such as the\norientation of fold axial surfaces – you can measure these accurately with a\nprotractor.","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"DQKqblFyzH"}],"key":"nHv90JAodc"}],"key":"KtZwFjbYwl"},{"type":"listItem","spread":true,"position":{"start":{"line":120,"column":1},"end":{"line":122,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":120,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Photograph your model at key intervals. Your group should also piece these photos\ntogether to make a video of your experiment; timelapse on your phone works well","position":{"start":{"line":120,"column":1},"end":{"line":120,"column":1}},"key":"woVpwdQL9y"}],"key":"tV1QxHUXiN"}],"key":"EMxdWHulDs"},{"type":"listItem","spread":true,"position":{"start":{"line":123,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":123,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"Do not overcontract your sandbox. The motor should automatically stop when you\nreach the maximum contraction but please observe closely just in case.","position":{"start":{"line":123,"column":1},"end":{"line":123,"column":1}},"key":"sNCpWHI6Os"}],"key":"xmEaQF5Ara"}],"key":"Gqz9PlzO8g"}],"key":"zdATl4MeKG"},{"type":"table","position":{"start":{"line":127,"column":1},"end":{"line":129,"column":1}},"children":[{"type":"tableRow","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"tableCell","header":true,"position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"children":[{"type":"text","value":"Displacement of indenter (cm)","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"xjq05KcnpT"}],"key":"TbYAKbL3Gs"},{"type":"tableCell","header":true,"position":{"start":{"line":127,"column":1},