:"Exercise 2, Plate Kinematics","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ZyZVjDkciZ"}],"identifier":"exercise-2-plate-kinematics","label":"Exercise 2, Plate Kinematics","html_id":"exercise-2-plate-kinematics","implicit":true,"key":"f7oYWXM12H"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"A basic understanding of plate kinematics is helpful in understanding how systems of plates evolve and\nthe boundary conditions they apply to the continental crust. It is also important to appreciate that the\n“rules” of plate boundary evolution are, in fact, emergent from complicated, multiscale systems.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Knf2h5gdO4"}],"key":"jSFAP8ypft"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You will need to read the notes on plate kinematics (section 2 of module 1) and it will help to have read\nJohn Dewey’s “PLATE TECTONICS.” Scientific American 226, no. 5 (1972): 56–72. ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"Wp9hkUh1c2"},{"type":"cite","url":"https://doi.org/10.1038/scientificamerican0572-56","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Dewey (1972)","key":"PeqKzdGxsw"}],"kind":"narrative","label":"dewey_plate_1972","identifier":"https://doi.org/10.1038/scientificamerican0572-56","enumerator":"1","key":"t858EU5duw"}],"key":"SxRvxdPh7E"},{"type":"div","style":{"width":"20%"},"children":[{"type":"paragraph","children":[{"type":"link","url":"/platekinematics","children":[{"type":"image","url":"/EMSC-3002/staging/build/Exercises_PlateKin_t-904fd7a036a52eb706eafe59601137a9.png","key":"IMZU6iNk19","urlSource":"Figures/Exercises_PlateKin_thumbnail.png"}],"urlSource":"Exercises/PlateKinematics","dataUrl":"/platekinematics.json","internal":true,"protocol":"file","key":"rhz5crC0jO"}],"key":"NrWCuzZagZ"},{"type":"paragraph","children":[{"type":"link","url":"/platekinematics","children":[{"type":"text","value":"Exercise 2 Worksheet","key":"yzSA80CSRe"}],"urlSource":"Exercises/PlateKinematics","dataUrl":"/platekinematics.json","internal":true,"protocol":"file","key":"AoKFvRjSjI"}],"key":"HUDBKeJAZK"}],"key":"SK1IgnKT3x"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Exercise 3, Sandbox Compression","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"sRW2WIeMAB"}],"identifier":"exercise-3-sandbox-compression","label":"Exercise 3, Sandbox Compression","html_id":"exercise-3-sandbox-compression","implicit":true,"key":"KwY06VNtFY"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Build your own mountain! We will be using a sandbox to build and run an analogue model and look at the deformation of a layered sequence of material.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"zKX7uONEpK"}],"key":"G0ICVf5QcN"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"link","url":"/sandboxcompression","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Exercise 3 Worksheet","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"qmvJKX6iSY"}],"urlSource":"Exercises/SandboxCompression","dataUrl":"/sandboxcompression.json","internal":true,"protocol":"file","key":"yYsmUGz5hA"}],"key":"qJhNuh0T2G"},{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Exercise 4, 3D Geometry of Rock Bodies using Google Earth","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"ab0tSXgu8v"}],"identifier":"exercise-4-3d-geometry-of-rock-bodies-using-google-earth","label":"Exercise 4, 3D Geometry of Rock Bodies using Google Earth","html_id":"exercise-4-3d-geometry-of-rock-bodies-using-google-earth","implicit":true,"key":"umN6L4vgqf"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Google Earth offers the ability to view topography in 3D, and in areas of good exposure, the interaction between topography and rock bodies can be clearly visualized by manipulating the viewer’s perspective.  Through this user interaction, a much clearer understanding of how outcrop patterns related to rock structure can be gained.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"O7QsJAMfN4"}],"key":"WGAiNOpMMY"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"link","url":"/mappingwithgoogleearth","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Exercise 4 Worksheet","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"XTE8WpS2bq"}],"urlSource":"Exercises/MappingWithGoogleEarth","dataUrl":"/mappingwithgoogleearth.json","internal":true,"protocol":"file","key":"m2edlloW4b"}],"key":"vIVBgNwpJp"},{"type":"heading","depth":2,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Exercise 5, Stress Analysis","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"s8cWvH8WzN"}],"identifier":"exercise-5-stress-analysis","label":"Exercise 5, Stress Analysis","html_id":"exercise-5-stress-analysis","implicit":true,"key":"WTwgcoO0OJ"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Knowing the stress state of our Earth is helpful in many ways. In this exercise, we will compute stress along a certain orientation given a stress tensor, predict whether a certain plane is going to fracture with the tool of Mohr circle and discuss what type of faults will develop under one specific stress state.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"nwAd2oKoHs"}],"key":"Ov4P1z20lv"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"link","url":"/stressanalysis","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Exercise 5 Worksheet","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"iExIqPTgU3"}],"urlSource":"Exercises/StressAnalysis","dataUrl":"/stressanalysis.json","internal":true,"protocol":"file","key":"PBYcrPV864"}],"key":"t4BbG2OSWi"},{"type":"heading","depth":2,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Exercise 6, Granular materials, angle of repose","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"aefrUNhJwu"}],"identifier":"exercise-6-granular-materials-angle-of-repose","label":"Exercise 6, Granular materials, angle of repose","html_id":"exercise-6-granular-materials-angle-of-repose","implicit":true,"key":"qjpsdGxB72"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"The internal friction angle in a granular material is a property that controls how the material responds to shearing and it can be\nmeasured approximately just by pouring the material into a pile and seeing the shape of the cone that forms.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"VJOYxomXI8"}],"key":"R1tSz8DqGN"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"ty